# STERYL_UP/.env.example
# Database Configuration
DATABASE_URL=postgresql://postgres:lamis@localhost/steryl_db

# Security
SECRET_
CSRF_SECRET_KEY=your-csrf-secret-key-here

# Session Security (set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# Logging
LOG_LEVEL=INFO
LOG_TO_CONSOLE=True

# CORS (for production, specify exact origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Email for error alerts (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@steryl.com
MAIL_ADMINS=admin1@steryl.com,admin2@steryl.com

# Rate Limiting
ENABLE_RATE_LIMITING=True